{
  "name": "ponker-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "TABLE", "class_name": "Table" }]
  },
  // free plan only allows sqlite backed objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }],
  // socket upgrades per address per minute. A house of friends on one wifi shares this, so it's generous
  "ratelimits": [{ "name": "CONNECTS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
}
